{
  "name": "song_helper",
  "version": "1.0.0",
  "private": true,
  "description": "移調小幫手 - 歌曲列表與 ABC 樂譜移調工具",
  "scripts": {
    "serve": "node tests/static-server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "update-songs": "node scripts/update-songs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0"
  }
}
